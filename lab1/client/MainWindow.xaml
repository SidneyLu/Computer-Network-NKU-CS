<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ChatClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="聊天客户端">
    <Grid Padding="20" RowSpacing="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="流式套接字聊天" FontSize="22" FontFamily="Microsoft YaHei UI"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="地址" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI"/>
            <TextBox x:Name="HostBox" Text="127.0.0.1" Width="140" AutomationProperties.AutomationId="HostBox"/>
            <TextBlock Text="端口" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI"/>
            <TextBox x:Name="PortBox" Text="9000" Width="80" AutomationProperties.AutomationId="PortBox"/>
            <TextBlock Text="昵称" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI"/>
            <TextBox x:Name="NickBox" Width="120" PlaceholderText="1–16 个字符" AutomationProperties.AutomationId="NickBox"/>
            <Button x:Name="ConnectButton" Content="连接" Click="Connect_Click" AutomationProperties.AutomationId="ConnectButton"/>
            <Button x:Name="DisconnectButton" Content="断开" Click="Disconnect_Click" IsEnabled="False" AutomationProperties.AutomationId="DisconnectButton"/>
            <Button x:Name="ListButton" Content="在线列表" Click="List_Click" IsEnabled="False" AutomationProperties.AutomationId="ListButton"/>
        </StackPanel>

        <ListView x:Name="MessageList" Grid.Row="2" FontFamily="Microsoft YaHei UI" AutomationProperties.AutomationId="MessageList"/>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" PlaceholderText="输入英文或中文消息" KeyDown="Input_KeyDown" AutomationProperties.AutomationId="InputBox"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="发送" Click="Send_Click" IsEnabled="False" AutomationProperties.AutomationId="SendButton"/>
            <NumberBox x:Name="BurstBox" Grid.Column="2" Value="100" Minimum="1" Maximum="500" Width="120" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="BurstBox"/>
            <Button x:Name="BurstButton" Grid.Column="3" Content="连续发送" Click="Burst_Click" IsEnabled="False" AutomationProperties.AutomationId="BurstButton"/>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="4" Text="未连接" FontFamily="Microsoft YaHei UI" TextWrapping="Wrap" AutomationProperties.AutomationId="StatusText"/>
    </Grid>
</Window>
